# === REQUIRED ===
SHOPIFY_SHOP=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_VERSION=2025-10

# === HIGHLY RECOMMENDED (for iPhone alerts) ===
# Create a bot with @BotFather on Telegram, then get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === OPTIONAL ===
OPENAI_API_KEY=

# How often the main loop runs (seconds)
POLL_INTERVAL=60

# Daily report hour (24h format, your local time roughly)
DAILY_REPORT_HOUR=8
